[Unit]
Description=AutoConnect config generator bot (@AutoVlessBot)
Documentation=https://github.com/arjeyproject/AutoConnect
After=network-online.target xray.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/autovless
EnvironmentFile=/etc/autovless/bot.env
ExecStart=/opt/autovless/venv/bin/python /opt/autovless/bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autovless-bot

# Hardening: the bot only needs its own state plus the Xray config.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/autovless /usr/local/etc/xray

[Install]
WantedBy=multi-user.target
